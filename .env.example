# ═══════════════════════════════════════════════════════════════════════
# Safety.uz Environment Variables - Example Configuration
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control!
# ═══════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────
# Flask Application Settings
# ─────────────────────────────────────────────────────────────────────
FLASK_ENV=production
SECRET_KEY=your-secret-key-here-change-this-to-random-string

# ─────────────────────────────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────────────────────────────
# PostgreSQL (Neon/Supabase/Local)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Example for Neon:
# DATABASE_URL=postgresql://neondb_owner:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Example for Supabase:
# DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres?sslmode=require

# ─────────────────────────────────────────────────────────────────────
# Backend URL Configuration
# ─────────────────────────────────────────────────────────────────────
# For local development:
BACKEND_URL=http://127.0.0.1:5000

# For Render.com production:
# BACKEND_URL=https://safety-uz-backend.onrender.com

# For custom domain:
# BACKEND_URL=https://safety.uz

# ─────────────────────────────────────────────────────────────────────
# Telegram Bot Configuration
# ─────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_TOKEN=your-telegram-bot-token-here

# ─────────────────────────────────────────────────────────────────────
# External APIs
# ─────────────────────────────────────────────────────────────────────
# Yandex Maps & Geocoder
YANDEX_GEOCODER_API=your-yandex-geocoder-api-key
YANDEX_MAPS_API=your-yandex-maps-api-key

# Google API
GOOGLE_API_KEY=your-google-api-key

# Serper API (for search)
SERPER_API_KEY=your-serper-api-key

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Uzum Market API
UZUM_API_TOKEN=your-uzum-api-token
UZUM_SHOP_ID=your-shop-id

# ─────────────────────────────────────────────────────────────────────
# SMTP Email Configuration
# ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=your-email@gmail.com

# ─────────────────────────────────────────────────────────────────────
# Business Settings
# ─────────────────────────────────────────────────────────────────────
AVG_PREP_MINUTES=7
DELIVERY_BASE_PRICE=10000
COURIER_BASE_RATE=8000
CASHBACK_PERCENTAGE=1.0
MAX_DELIVERY_DISTANCE=50.0

# ─────────────────────────────────────────────────────────────────────
# Localization
# ─────────────────────────────────────────────────────────────────────
DEFAULT_LANGUAGE=uz
DEFAULT_CURRENCY=UZS
TIMEZONE=Asia/Tashkent

# ─────────────────────────────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────────────────────────────
RATE_LIMIT_DAILY=1000
RATE_LIMIT_HOURLY=200
RATE_LIMIT_MINUTE=50

# ─────────────────────────────────────────────────────────────────────
# Performance
# ─────────────────────────────────────────────────────────────────────
THREAD_POOL_MAX_WORKERS=10
DB_POOL_MAX_CONNECTIONS=20

# ─────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# ─────────────────────────────────────────────────────────────────────
# Admin Access
# ─────────────────────────────────────────────────────────────────────
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=change-this-password

# Swagger UI credentials
SWAGGER_USER=admin
SWAGGER_PASS=change-this-password

# ─────────────────────────────────────────────────────────────────────
# Redis (Optional)
# ─────────────────────────────────────────────────────────────────────
# Use in-memory fallback if Redis not available
REDIS_URL=memory://

# For production Redis:
# REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────────────────────────────
PORT=5000
HOST=0.0.0.0
BOT_PORT=10001

# ─────────────────────────────────────────────────────────────────────
# Python Settings
# ─────────────────────────────────────────────────────────────────────
PYTHONUNBUFFERED=1
