#!/usr/bin/env python3
import re
from pathlib import Path
import sys

# File extensions to process
EXTS = {'.html','.htm','.js','.css','.py','.md','.txt','.json','.jinja','.cfg','.yml','.yaml'}

# Emoji unicode ranges covering most emoji blocks + variation selectors and joiner
emoji_ranges = (
    "\u2190-\u21FF"  # arrows
    "\u2600-\u26FF"  # miscellaneous symbols
    "\u2700-\u27BF"  # dingbats
    "\U0001F300-\U0001F5FF"  # misc symbols and pictographs
    "\U0001F600-\U0001F64F"  # emoticons
    "\U0001F680-\U0001F6FF"  # transport and map
    "\U0001F700-\U0001F77F"  # alchemical
    "\U0001F780-\U0001F7FF"  # Geometric Shapes Extended
    "\U0001F800-\U0001F8FF"  # Supplemental Arrows-C etc
    "\U0001F900-\U0001F9FF"  # Supplemental Symbols and Pictographs
    "\U0001FA00-\U0001FA6F"  # Chess etc
    "\U0001FA70-\U0001FAFF"  # Symbols and Pictographs Extended-A
)
# Variation selectors and joiner
extras = "\uFE0F\uFE0E\u200D"

pattern = re.compile("[" + emoji_ranges + extras + "]+", flags=re.UNICODE)

root = Path(r"c:\Users\Moxir_Coder\OneDrive\Desktop\Pro-Obuv")
if not root.exists():
    print('Workspace root not found:', root)
    sys.exit(1)

changed = []

for p in root.rglob('*'):
    if p.is_file():
        if p.suffix.lower() in EXTS or p.name.lower().endswith('.tmpl') or p.suffix == '':
            try:
                text = p.read_text(encoding='utf-8')
            except Exception:
                # skip binary/unreadable
                continue
            new = pattern.sub('', text)
            # Also remove standalone special emoji characters that may not be matched
            # like heavy black heart etc in BMP
            new = new.replace('️','')  # remove variation selector (if any remained)
            if new != text:
                bak = p.with_suffix(p.suffix + '.bak')
                try:
                    p.rename(bak)
                except Exception:
                    # fallback: write backup copy with .bak appended
                    p.with_name(p.name + '.bak').write_text(text, encoding='utf-8')
                p.write_text(new, encoding='utf-8')
                changed.append(str(p.relative_to(root)))

print('Done. Files modified:', len(changed))
for f in changed:
    print(' -', f)

if not changed:
    print('No files changed.')
