/* Minimal Telegram-like staff chat styles */
:root {
  --chat-bg: #f6f8fb;
  --panel-bg: #ffffff;
  --accent: #2b7de9;
  --muted: #7a8794;
}
.staff-chat-app {
  display: flex;
  height: 78vh;
  max-height: 900px;
  border: 1px solid #e6e9ee;
  background: var(--chat-bg);
  border-radius: 6px;
  overflow: hidden;
}
.chat-list {
  width: 300px;
  background: var(--panel-bg);
  border-right: 1px solid #e6e9ee;
  display: flex;
  flex-direction: column;
}
.chat-list-header {
  padding: 12px 16px;
  font-weight: 600;
  border-bottom: 1px solid #f0f2f5;
}
.chat-items {
  overflow: auto;
  padding: 8px;
}
.chat-item {
  padding: 10px;
  border-radius: 6px;
  margin-bottom: 8px;
  cursor: pointer;
  border: 1px solid transparent;
}
.chat-item.unread {
  background: #eef6ff;
  border-color: rgba(43, 125, 233, 0.12);
}
.chat-item .name {
  font-weight: 600;
}
.chat-window {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: var(--panel-bg);
}
.chat-window-header {
  padding: 12px 16px;
  border-bottom: 1px solid #f0f2f5;
  font-weight: 600;
}
.chat-messages {
  flex: 1;
  padding: 12px;
  overflow: auto;
  background: linear-gradient(#ffffff, #f7fbff);
}
.msg {
  margin: 8px 0;
  max-width: 70%;
  padding: 8px 12px;
  border-radius: 8px;
  display: inline-block;
}
.msg.user {
  background: #eef6ff;
  align-self: flex-end;
  border-bottom-right-radius: 2px;
}
.msg.operator {
  background: #f1f4f6;
  align-self: flex-start;
  border-bottom-left-radius: 2px;
}
.chat-send-form {
  display: flex;
  padding: 10px;
  border-top: 1px solid #f0f2f5;
}
.chat-send-form input {
  flex: 1;
  padding: 10px;
  border: 1px solid #e0e4ea;
  border-radius: 6px;
  margin-right: 8px;
}
.chat-send-form button {
  background: var(--accent);
  color: #fff;
  border: none;
  padding: 10px 14px;
  border-radius: 6px;
  cursor: pointer;
}
@media (max-width: 800px) {
  .staff-chat-app {
    flex-direction: column;
    height: 70vh;
  }
  .chat-list {
    width: 100%;
    height: 140px;
    order: 2;
    overflow: auto;
  }
  .chat-window {
    order: 1;
    height: calc(100% - 140px);
  }
}
