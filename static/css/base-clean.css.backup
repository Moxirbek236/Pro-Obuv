/* base-clean.css
   Purpose: Minimal, high-quality overrides to improve layout, navbar, accessibility
   and responsive behavior without changing existing template structure.
   Loaded after styles.css to safely override styles where needed.
*/

:root {
  /* design tokens */
  --bg: #ffffff;
  --surface: #f8fafc;
  --text: #111827;
  --muted: #6b7280;
  --brand: #ffb020;
  --brand-600: #d18b00;
  --accent: #1976d2;
  --radius: 10px;
  --shadow-sm: 0 4px 12px rgba(16, 24, 40, 0.06);
}

/* Respect existing dark theme toggle if present */
body.dark-theme {
  --bg: #0b1220;
  --surface: #0f1724;
  --text: #e6eef8;
  --muted: #9aa6b2;
  --brand: #ffb020;
}

/* Base layout cleanup */
html,
body {
  height: 100%;
  margin: 0;
  padding: 0;
  background: var(--bg);
  color: var(--text);
  font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto,
    "Helvetica Neue", Arial;
}
.container {
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 16px;
}

/* Header / brand */
.site-header {
  background: transparent;
  border-bottom: 1px solid rgba(0, 0, 0, 0.04);
}
.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 16px;
}
.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  color: inherit;
}
.brand .title {
  font-weight: 700;
  font-size: 1.05rem;
  letter-spacing: 0.2px;
}
.brand img {
  height: 44px;
  width: auto;
  display: block;
}

/* Nav actions (simple menu and bootstrap nav harmony) */
.nav-actions,
.navbar-nav {
  display: flex;
  align-items: center;
  gap: 6px;
}
.nav-actions a,
.navbar .nav-link {
  color: var(--text);
  text-decoration: none;
  padding: 8px 12px;
  border-radius: 8px;
  font-weight: 600;
  transition: all 160ms ease;
}
.nav-actions a:hover,
.navbar .nav-link:hover {
  background: var(--accent);
  color: #fff !important;
  transform: translateY(-2px);
  box-shadow: var(--shadow-sm);
}

/* Cart badge and small UI fixes */
.cart-badge {
  background: #ef4444;
  color: #fff;
  border-radius: 999px;
  padding: 2px 7px;
  font-size: 12px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 20px;
}

/* Navbar appearance for bootstrap-dark variants */
.navbar {
  padding: 8px 12px;
}
.navbar-dark {
  background: linear-gradient(90deg, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.3));
}
.navbar-dark .nav-link {
  color: rgba(255, 255, 255, 0.95);
}

/* Dropdowns */
.dropdown-menu {
  border-radius: 12px;
  box-shadow: 0 10px 30px rgba(2, 6, 23, 0.12);
  border: 1px solid rgba(0, 0, 0, 0.06);
}
.dropdown-menu .dropdown-item:hover {
  background: rgba(0, 0, 0, 0.04);
}

/* Footer improvements */
.footer {
  background: linear-gradient(135deg, #0f1724 0%, #111827 100%);
  color: #e6eef8;
  padding: 36px 0;
}
.footer .social-icon-btn {
  width: 40px;
  height: 40px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.04);
}

/* Accessibility focus states */
a:focus,
.nav-link:focus,
.dropdown-item:focus,
button:focus {
  outline: 3px solid rgba(255, 176, 32, 0.16);
  outline-offset: 2px;
}

/* Responsive tweaks */
@media (max-width: 992px) {
  .container {
    padding-left: 12px;
    padding-right: 12px;
  }
}
@media (max-width: 768px) {
  .nav-actions {
    display: none;
  }
  .brand .title {
    display: none;
  }
  .header-inner {
    padding: 10px;
  }
}

/* Gentle helpers to avoid regressions caused by inline styles */
.card {
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
}
.text-muted {
  color: var(--muted) !important;
}

/* Keep menu prices hidden by default: match existing utility (safe override) */
.item-price,
.menu-item-price,
.price-section,
.price-label {
  visibility: hidden !important;
  height: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  overflow: hidden !important;
}
body.show-prices .item-price,
body.show-prices .menu-item-price,
body.show-prices .price-section,
body.show-prices .price-label {
  visibility: visible !important;
  height: auto !important;
  padding: inherit !important;
  margin: inherit !important;
  overflow: visible !important;
}

/* small animation (respects reduced motion) */
@media (prefers-reduced-motion: no-preference) {
  .nav-actions a,
  .nav-link {
    transition: transform 160ms cubic-bezier(0.2, 0.9, 0.3, 1), box-shadow 160ms,
      background 160ms;
  }
}

/* End of base-clean.css */

/* ===== MOVED FROM templates/base.html =====
  Footer, news-ticker, media modal, floating cart, chat widget,
  responsive helpers, avatar and price utilities were inline in
  templates/base.html. They have been moved here to centralize
  styling and improve maintainability.
*/

/* Footer & social icons (moved) */
.footer {
  background: linear-gradient(135deg, #1a202c 0%, #2d3748 100%);
  border-top: 3px solid #ffc107;
  position: relative;
  z-index: 1000 !important;
}
.footer .hover-text-warning:hover {
  color: #ffc107 !important;
  transition: color 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
.social-icon-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 45px;
  height: 45px;
  border-radius: 50%;
  transition: all 0.4s;
  text-decoration: none;
  border: 2px solid rgba(255, 255, 255, 0.15);
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(15px) saturate(180%);
  position: relative;
  overflow: hidden;
}
.social-icon-btn::before {
  content: "";
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.2),
    transparent
  );
  transition: left 0.5s ease;
}
.social-icon-btn:hover::before {
  left: 100%;
}
.social-icon-btn:hover {
  transform: translateY(-4px) scale(1.15);
  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.4);
  border-color: rgba(255, 255, 255, 0.3);
}
.social-icon-btn.facebook:hover {
  background: linear-gradient(135deg, #1877f2 0%, #166fe5 100%);
  box-shadow: 0 12px 35px rgba(24, 119, 242, 0.5);
}
.footer .input-group .form-control {
  border: 2px solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
  color: white;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
.footer .input-group .form-control::placeholder {
  color: rgba(255, 255, 255, 0.6);
}
.footer .input-group .form-control:focus {
  border-color: #ffc107;
  box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.25);
  background: rgba(255, 255, 255, 0.08);
  transform: translateY(-1px);
}
.footer .btn-warning {
  background: linear-gradient(135deg, #ffc107 0%, #e0a800 100%);
  border: none;
  transition: all 0.3s;
  font-weight: 600;
}
.footer .btn-warning:hover {
  background: linear-gradient(135deg, #e0a800 0%, #cc9a06 100%);
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(255, 193, 7, 0.4);
}
.footer .badge {
  font-size: 0.9rem;
  font-weight: 600;
  transition: all 0.3s;
  cursor: pointer;
  position: relative;
  overflow: hidden;
}
.footer .badge:hover {
  transform: translateY(-2px) scale(1.08);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
}

/* News ticker moved */
.news-ticker-container {
  background: linear-gradient(135deg, #0a0a0b 0%, #1a1b23 50%, #0f1419 100%);
  border-top: 2px solid #2d3748;
  position: relative;
  z-index: 100 !important;
  box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.4),
    inset 0 1px 0 rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
}
.news-ticker-wrapper {
  display: flex;
  align-items: stretch;
  padding: 24px 30px;
  position: relative;
  gap: 20px;
  max-width: 1600px;
  margin: 0 auto;
  min-height: 100px;
  overflow: visible;
}
.news-ticker {
  flex: 1 1 auto;
  height: 100%;
  min-height: 120px;
  position: relative;
  border-radius: 15px;
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(15px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.2);
  margin: 0 8px;
}
.news-ticker-viewport {
  width: 100%;
  height: 100%;
  overflow: hidden;
  position: relative;
  border-radius: 15px;
  display: flex;
  align-items: stretch;
}
.news-ticker-content {
  display: flex;
  align-items: stretch;
  height: 100%;
  position: relative;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  gap: 20px;
  padding: 16px;
  flex-wrap: nowrap;
}
.news-nav-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1100;
  width: 56px;
  height: 56px;
  border: none;
  background: linear-gradient(135deg, #374151 0%, #1f2937 100%);
  color: #fff;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  font-weight: 700;
  transition: all 0.22s;
  box-shadow: 0 8px 22px rgba(0, 0, 0, 0.45);
  border: 2px solid rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(10px);
  padding: 6px;
}
.news-nav-btn.news-nav-prev {
  left: 14px;
}
.news-nav-btn.news-nav-next {
  right: 14px;
}
.news-nav-btn:hover {
  background: linear-gradient(135deg, #22d3ee 0%, #0891b2 100%);
  transform: scale(1.1);
  box-shadow: 0 6px 20px rgba(34, 211, 238, 0.4);
  border-color: rgba(255, 255, 255, 0.3);
}
.news-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  flex: 0 0 320px;
  min-width: 260px;
  height: 160px;
  padding: 12px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 15px;
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  position: relative;
  overflow: hidden;
  transition: all 0.3s;
  cursor: pointer;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
}
.news-item:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
  background: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.25);
}
.news-item.news {
  border-left: 4px solid #22d3ee;
}
.news-item.advertisement {
  border-left: 4px solid #fbbf24;
  background: rgba(251, 191, 36, 0.1);
}
.news-media {
  width: 100%;
  height: auto;
  max-height: 200px;
  object-fit: cover;
  border-radius: 8px;
  margin-bottom: 8px;
  display: block;
}
.news-title {
  color: #ffffff;
  font-size: 14px;
  font-weight: 600;
  text-align: center;
  line-height: 1.2;
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
  overflow-wrap: break-word;
  word-break: break-word;
  white-space: pre-wrap;
}
.news-content {
  color: rgba(255, 255, 255, 0.8);
  font-size: 12px;
  text-align: center;
  line-height: 1.3;
  margin-top: 4px;
  overflow-wrap: break-word;
  word-break: break-word;
  white-space: pre-wrap;
}

/* Floating cart moved */
.floating-cart-global {
  position: fixed;
  bottom: 20px;
  left: 20px;
  background: linear-gradient(135deg, #38a169 0%, #2f855a 100%);
  width: 80px;
  height: 80px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: 0 10px 40px rgba(56, 161, 105, 0.8);
  z-index: 9999 !important;
  transition: all 0.4s;
  border: 4px solid rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(15px);
  color: white;
  animation: cartPulse 3s ease-in-out infinite;
}
.floating-cart-global .cart-icon {
  font-size: 32px;
  animation: iconBounce 2s ease-in-out infinite;
}
.floating-cart-global .cart-badge-floating {
  position: absolute;
  top: -5px;
  right: -5px;
  background: linear-gradient(135deg, #e53e3e 0%, #c53030 100%);
  color: white;
  border-radius: 50%;
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 900;
  transform: scale(0);
  transition: transform 0.3s;
  border: 3px solid white;
  box-shadow: 0 4px 12px rgba(229, 62, 62, 0.6);
}
.floating-cart-global .cart-badge-floating.show {
  transform: scale(1);
  animation: badgePulse 1.5s ease-in-out infinite;
}

/* Media modal moved */
.media-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.9);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  backdrop-filter: blur(5px);
}
.media-modal-content {
  background: #ffffff;
  border-radius: 15px;
  max-width: 90vw;
  max-height: 90vh;
  width: auto;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  overflow: hidden;
  position: relative;
}
.media-modal-header {
  padding: 20px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.media-modal-body {
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 200px;
  background: #000000;
}
.modal-media-image {
  max-width: 100%;
  max-height: 80vh;
  object-fit: contain;
}
.modal-media-video {
  max-width: 100%;
  max-height: 80vh;
}
body.dark-theme .media-modal-content {
  background: #1a1a1a;
  color: #ffffff;
  border: 1px solid #3d3d3d;
}

/* Chat widget moved (only active for staff/courier/superadmin) */
.chat-fab {
  position: fixed;
  right: 20px;
  bottom: 20px;
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: linear-gradient(135deg, #0088cc, #00a8ff);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 25px rgba(0, 136, 204, 0.4);
  cursor: pointer;
  z-index: 2000;
  transition: all 0.3s;
  font-size: 24px;
  border: 3px solid white;
}
.chat-fab:hover {
  transform: scale(1.1);
  box-shadow: 0 12px 35px rgba(0, 136, 204, 0.6);
}
.chat-panel {
  position: fixed;
  right: 20px;
  bottom: 100px;
  width: 560px;
  height: 760px;
  background: #ffffff;
  border-radius: 20px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  overflow: hidden;
  display: none;
  flex-direction: column;
  border: 1px solid #e1e8ed;
}
.chat-panel.show {
  display: flex;
  animation: slideUp 0.3s ease-out;
}
@keyframes slideUp {
  from {
    transform: translateY(100px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
.chat-header {
  background: linear-gradient(135deg, #0088cc, #00a8ff);
  color: white;
  padding: 15px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2px 10px rgba(0, 136, 204, 0.3);
}
.chat-list {
  width: 200px;
  background: #f8f9fa;
  border-right: 1px solid #e1e8ed;
  overflow-y: auto;
}
.chat-list-header {
  padding: 15px;
  background: #e9ecef;
  border-bottom: 1px solid #dee2e6;
  font-weight: 600;
  color: #495057;
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.chat-item {
  padding: 12px 15px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 12px;
  transition: all 0.2s;
  border-left: 3px solid transparent;
}
.chat-item:hover {
  background: #e3f2fd;
  border-left-color: #0088cc;
}
.chat-item.active {
  background: #e3f2fd;
  border-left-color: #0088cc;
}
.chat-item-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: linear-gradient(135deg, #0088cc, #00a8ff);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-weight: 600;
  font-size: 16px;
  position: relative;
  overflow: hidden;
}

/* Avatar and avatar sizing moved */
img.app-avatar,
img.rounded-circle {
  border-radius: 50% !important;
  object-fit: cover !important;
  display: inline-block !important;
}
.navbar img.app-avatar {
  width: 32px !important;
  height: 32px !important;
}
.dropdown-menu img.app-avatar {
  width: 48px !important;
  height: 48px !important;
}

/* Price hiding utility (preserved) */
.item-price,
.menu-item-price,
.price-section,
.price-label {
  visibility: hidden !important;
  height: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
  overflow: hidden !important;
}
body.show-prices .item-price,
body.show-prices .menu-item-price,
body.show-prices .price-section,
body.show-prices .price-label {
  visibility: visible !important;
  height: auto !important;
  margin: initial !important;
  padding: initial !important;
  overflow: visible !important;
}

/* Responsive helpers moved */
@media (max-width: 992px) {
  .container,
  .main-content {
    padding-left: 12px;
    padding-right: 12px;
  }
  .fixed-top-custom {
    position: sticky !important;
  }
}
@media (max-width: 576px) {
  .nav-link {
    padding: 6px 8px !important;
    font-size: 14px;
  }
  .dropdown-menu {
    font-size: 14px;
  }
  .hero-section {
    padding: 40px 12px;
  }
}

/* End moved CSS */
