
/* Base improvements and menu refinements for Pro-Obuv
	 - Small, non-destructive overrides to improve navbar, menu, and base layout
	 - Responsive, accessible, and theme-aware
	 - Loaded after main styles.css so it can override when necessary
*/
:root {
	--po-bg: #0f1724; /* dark base used when dark-theme is active */
	--po-surface: #0b1220;
	--po-contrast: #ffffff;
	--po-muted: #9aa6b2;
	--po-primary: #ffb020; /* warmer brand accent */
	--po-accent-2: #1976d2;
	--po-radius: 12px;
}

/* Base layout tweaks */
html,
body {
	height: 100%;
}
body {
	-webkit-font-smoothing: antialiased;
	-moz-osx-font-smoothing: grayscale;
}
.container {
	max-width: 1180px;
	margin: 0 auto;
	padding: 0 16px;
}

/* Header */
.site-header {
	background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent);
	border-bottom: 1px solid rgba(0, 0, 0, 0.06);
}
.header-inner {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 14px 16px;
	gap: 12px;
}
.brand {
	display: flex;
	align-items: center;
	gap: 10px;
	text-decoration: none;
	color: inherit;
	font-weight: 700;
}
.brand img {
	height: 44px;
	width: auto;
}
.brand .title {
	font-size: 1.05rem;
	letter-spacing: 0.6px;
}

/* Nav actions (simple menu) */
.nav-actions {
	display: flex;
	align-items: center;
	gap: 6px;
}
.nav-actions a {
	display: inline-flex;
	align-items: center;
	padding: 8px 12px;
	border-radius: 10px;
	color: var(--text-color);
	text-decoration: none;
	font-weight: 600;
	transition: all 0.18s ease;
}
.nav-actions a:hover {
	background: var(--po-accent-2);
	color: #fff;
	transform: translateY(-2px);
	box-shadow: 0 6px 18px rgba(25, 118, 210, 0.08);
}

/* Primary Navbar improvements (Bootstrap-based) */
.navbar {
	padding: 10px 16px;
}
.navbar .navbar-brand {
	font-weight: 700;
}
.navbar .nav-link {
	padding: 0.6rem 0.8rem;
	border-radius: 8px;
	transition: background 0.18s ease, color 0.18s ease, transform 0.18s;
}
.navbar .nav-link:hover {
	background: rgba(255, 255, 255, 0.06);
	transform: translateY(-2px);
}
.navbar-dark .nav-link {
	color: rgba(255, 255, 255, 0.92);
}

/* Cart button improvements */
.cart-btn {
	background: transparent;
	border-radius: 8px;
	padding: 6px 10px;
}
.cart-btn i {
	font-size: 1.05rem;
}
.cart-badge {
	background: #e11d48;
	color: #fff;
	min-width: 20px;
	height: 20px;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	border-radius: 999px;
	font-size: 12px;
	padding: 0 6px;
}

/* Dropdown menu: slightly rounded and with shadow for clarity */
.dropdown-menu {
	border-radius: 12px;
	box-shadow: 0 10px 30px rgba(2, 6, 23, 0.18);
	border: 1px solid rgba(0, 0, 0, 0.05);
}
.dropdown-menu .dropdown-item {
	padding: 0.6rem 0.9rem;
}
.dropdown-menu .dropdown-item:hover {
	background: rgba(0, 0, 0, 0.04);
}

/* Accessibility: focus states */
.nav-link:focus,
.dropdown-item:focus,
.btn:focus,
a:focus {
	outline: 3px solid rgba(255, 176, 32, 0.18);
	outline-offset: 2px;
	border-radius: 8px;
}

/* Responsive: collapse long nav to compact icons on small screens */
@media (max-width: 768px) {
	.nav-actions {
		display: none;
	}
	.brand .title {
		display: none;
	}
	.header-inner {
		padding: 10px;
	}
}

/* Improve footer readability */
.footer {
	font-size: 0.95rem;
}
.footer h5,
.footer h6 {
	color: var(--po-primary);
}
.footer .social-icon-btn {
	width: 40px;
	height: 40px;
}

/* Small helpers */
.text-muted-2 {
	color: var(--po-muted);
}
.card {
	border-radius: var(--po-radius);
}

/* Dark theme adjustments (applies when body.dark-theme) */
body.dark-theme {
	background: var(--po-bg);
	color: var(--po-contrast);
}
body.dark-theme .site-header {
	background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent);
	border-bottom: 1px solid rgba(255, 255, 255, 0.03);
}
body.dark-theme .brand .title {
	color: var(--po-contrast);
}
body.dark-theme .nav-link,
body.dark-theme .navbar-brand {
	color: rgba(255, 255, 255, 0.92);
}
body.dark-theme .nav-actions a:hover {
	background: var(--po-accent-2);
}

/* Small animation to make nav feel lively on hover */
@media (prefers-reduced-motion: no-preference) {
	.nav-link,
	.nav-actions a {
		transition: transform 0.18s cubic-bezier(0.2, 0.9, 0.3, 1), box-shadow 0.18s,
			background 0.18s;
	}
}

/* Keep menu item prices hidden unless explicit (matches existing utility) */
.show-prices .item-price,
.show-prices .menu-item-price {
	visibility: visible;
	height: auto;
}

/* Minor improvement: ensure header does not overlap fixed content when using fixed-top-custom */
.body-with-fixed-header {
	padding-top: 72px;
}

/* Ensure news ticker buttons are visible on dark backgrounds */
.news-nav-btn {
	background: rgba(0, 0, 0, 0.35);
	color: #fff;
	border-radius: 999px;
	width: 36px;
	height: 36px;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	border: none;
}

/* End of base-improvements.css */

